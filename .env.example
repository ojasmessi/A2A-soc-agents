# Copy this file to ".env" and put your real key in it.  NEVER commit .env to GitHub.
OPENAI_API_KEY=sk-your-key-here

# Which OpenAI model both agents use (cheap + good with tools is ideal)
OPENAI_MODEL=gpt-5-mini

# Where the LangGraph Threat-Intel agent runs (A2A server)
THREAT_INTEL_HOST=localhost
THREAT_INTEL_PORT=10001

# Where the ADK SOC-Triage agent runs when YOU expose it over A2A (step 7)
TRIAGE_PORT=10002
